<?xml version="1.0"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8" enableVersionHeader="false"/>
  </system.web>
  <system.webServer>
    <staticContent>
      <!-- HTML, CSS, JS, the manifest and the service worker always revalidate (cheap 304s);
           the service worker serves them cache-first anyway. Images get long caching below. -->
      <clientCache cacheControlMode="DisableCache"/>
      <remove fileExtension=".html"/>
      <mimeMap fileExtension=".html" mimeType="text/html;charset=utf-8"/>
      <remove fileExtension=".svg"/>
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml"/>
      <remove fileExtension=".json"/>
      <mimeMap fileExtension=".json" mimeType="application/json"/>
      <remove fileExtension=".webmanifest"/>
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json"/>
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="x-powered-by"/>
        <add name="Content-Security-Policy" value="object-src 'none';"/>
        <add name="Arr-Disable-Session-Affinity" value="True"/>
        <add name="Vary" value="Accept-Encoding, If-Modified-Since"/>
      </customHeaders>
    </httpProtocol>
    <rewrite>
      <rules>
        <!-- One canonical origin: www, the old azurewebsites.net host and the .com domain go to https://gamethetime.fun.
             Hosts not listed here (localhost, deployment slots) are left alone. -->
        <rule name="Canonical host" stopProcessing="true">
          <match url="(.*)"/>
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTP_HOST}" pattern="^www\.gamethetime\.fun$"/>
            <add input="{HTTP_HOST}" pattern="^timescore\.azurewebsites\.net$"/>
            <add input="{HTTP_HOST}" pattern="^(www\.)?gamethetime\.com$"/>
          </conditions>
          <action type="Redirect" url="https://gamethetime.fun/{R:1}" redirectType="Permanent" appendQueryString="true"/>
        </rule>
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)"/>
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="^OFF$"/>
            <add input="{HTTP_HOST}" pattern="^gamethetime\.fun$"/>
          </conditions>
          <action type="Redirect" url="https://gamethetime.fun/{R:1}" redirectType="Permanent" appendQueryString="true"/>
        </rule>
      </rules>
      <outboundRules rewriteBeforeCache="false">
        <rule name="Send correct Vary">
          <match serverVariable="RESPONSE_Vary" pattern=".+"/>
          <action type="Rewrite" value="Accept-Encoding, If-Modified-Since"/>
        </rule>
      </outboundRules>
    </rewrite>
  </system.webServer>
  <!-- Icons, startup images and the share image change rarely: cache them for 30 days. -->
  <location path="favicon">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" cacheControlCustom="public"/>
      </staticContent>
    </system.webServer>
  </location>
  <location path="assets/img">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" cacheControlCustom="public"/>
      </staticContent>
    </system.webServer>
  </location>
</configuration>
